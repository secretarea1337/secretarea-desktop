{
  "name": "secretarea",
  "private": true,
  "version": "1.0.12",
  "description": "SecretArea Desktop Game Launcher",
  "repository": "https://github.com/secretarea1337/secretarea-desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "secretarea.desktop",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "desktop:build": "vite build && electron-builder --win nsis",
    "desktop:build:win": "vite build && electron-builder --win nsis --x64 --publish never",
    "desktop:build:linux": "vite build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "build": {
    "appId": "site.secretarea.desktop",
    "productName": "SecretArea",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "hardware-db.json",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "secretarea1337",
        "repo": "secretarea-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/img/logo01.png",
      "artifactName": "SecretArea.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SecretArea"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "packaging/linux/icons",
      "category": "Game",
      "syncDesktopName": true,
      "synopsis": "SecretArea Desktop Game Launcher",
      "description": "SecretArea Desktop Game Launcher with hardware monitoring, downloads manager, and multi-store game tools.",
      "maintainer": "SecretArea <support@secretarea.site>",
      "vendor": "SecretArea",
      "desktop": {
        "entry": {
          "Name": "SecretArea",
          "Comment": "SecretArea Desktop Game Launcher",
          "Categories": "Game;Utility;",
          "StartupWMClass": "SecretArea",
          "Terminal": "false"
        }
      }
    },
    "appImage": {
      "artifactName": "SecretArea-${version}-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "SecretArea-${version}-linux-amd64.deb",
      "packageCategory": "games",
      "priority": "optional",
      "compression": "gz"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "megajs": "^1.3.10",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "systeminformation": "^5.33.24",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
